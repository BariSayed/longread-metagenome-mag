// HPC profile — adjust queue/partition names to your cluster.
process {
    executor       = 'slurm'
    queue          = 'normal'
    clusterOptions = '--account=YOUR_ACCOUNT'
}
executor {
    queueSize      = 20
    submitRateLimit = '10/1min'
}
apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = "$projectDir/containers/cache"
}
