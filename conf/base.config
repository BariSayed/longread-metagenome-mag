// Per-process resource labels and container images (pinned tags).
// Images are pulled from quay.io/biocontainers unless noted.
process {
    errorStrategy = { task.exitStatus in [137,139,140,143,247] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel:process_low    { cpus = 2;  memory = 12.GB; time = 4.h  }
    withLabel:process_medium { cpus = 8;  memory = 48.GB; time = 12.h }
    withLabel:process_high   { cpus = 24; memory = 180.GB; time = 48.h }

    withName:NANOPLOT    { container = 'quay.io/biocontainers/nanoplot:1.42.0--pyhdfd78af_0' }
    withName:CCS         { container = 'quay.io/biocontainers/pbccs:6.4.0--h9ee0642_0' }
    withName:MINIMAP2_HOST { container = 'quay.io/biocontainers/minimap2:2.28--he4a0461_0' }
    withName:METAMDBG    { container = 'quay.io/biocontainers/metamdbg:1.0--h077b44d_0' }
    withName:MINIMAP2_MAP { container = 'quay.io/biocontainers/minimap2:2.28--he4a0461_0' }
    withName:METABAT2    { container = 'quay.io/biocontainers/metabat2:2.15--h4da6f23_2' }
    withName:SEMIBIN2    { container = 'quay.io/biocontainers/semibin:2.1.0--pyhdfd78af_0' }
    withName:DASTOOL     { container = 'quay.io/biocontainers/das_tool:1.1.7--r43hdfd78af_0' }
    withName:CHECKM2     { container = 'quay.io/biocontainers/checkm2:1.0.2--pyh7cba7a3_0' }
    withName:GUNC        { container = 'quay.io/biocontainers/gunc:1.0.6--pyhdfd78af_0' }
    withName:DREP        { container = 'quay.io/biocontainers/drep:3.5.0--pyhdfd78af_0' }
    withName:GTDBTK      { container = 'quay.io/biocontainers/gtdbtk:2.4.0--pyhdfd78af_1' }
    withName:BAKTA       { container = 'quay.io/biocontainers/bakta:1.9.4--pyhdfd78af_0' }
    withName:DRAM        { container = 'quay.io/biocontainers/dram:1.5.0--pyhdfd78af_0' }
    withName:AMRFINDERPLUS { container = 'quay.io/biocontainers/ncbi-amrfinderplus:3.12.8--h283d18e_0' }
    withName:GENOMAD     { container = 'quay.io/biocontainers/genomad:1.8.0--pyhdfd78af_0' }
    withName:SYLPH       { container = 'quay.io/biocontainers/sylph:0.6.1--h4349ce8_0' }
}
