// ==========================================================================
//  longread-metagenome-mag  —  Nextflow DSL2 pipeline configuration
//  PacBio HiFi / Nanopore host-associated metagenome -> MAGs -> function
// ==========================================================================
nextflow.enable.dsl = 2

manifest {
    name            = 'longread-metagenome-mag'
    author          = 'Sayed Mashequl Bari (BariSayed)'
    description      = 'Reproducible long-read (HiFi/Nanopore) metagenome assembly, binning, MAG QC, taxonomy and function.'
    mainScript       = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}

params {
    // --- input / output ---
    input       = 'assets/samplesheet.csv'   // sample,run_accession,...,fastq (local path or FTP)
    outdir      = 'results'
    platform    = 'hifi'                      // 'hifi' | 'nanopore' | 'clr' (raw PacBio subreads -> metaFlye)

    // --- host removal ---
    host_fasta  = null                        // host genome FASTA (minimap2 target); null = skip

    // --- databases (set on the server before running) ---
    checkm2_db  = null
    gunc_db     = null
    gtdbtk_db   = null
    bakta_db    = null
    genomad_db  = null
    amrfinder_db = null
    sylph_db    = null

    // --- MAG quality thresholds (MIMAG) ---
    min_completeness = 50
    max_contamination = 10

    // --- resources / misc ---
    max_cpus    = 32
    max_memory  = '256.GB'
    max_time    = '72.h'
    help        = false
}

profiles {
    standard   { process.executor = 'local' }
    apptainer  {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.cacheDir   = "$projectDir/containers/cache"
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    slurm      { includeConfig 'conf/slurm.config' }
    test       { includeConfig 'conf/test.config'  }
}

includeConfig 'conf/base.config'

// Reproducibility: timeline / report / trace / DAG
def trace_ts = new java.util.Date().format('yyyyMMdd_HHmmss')
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${trace_ts}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${trace_ts}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${trace_ts}.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag_${trace_ts}.html" }
